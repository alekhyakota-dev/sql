use dept;
create table t1(
id int primary key,
name varchar(100),
age int,
phone bigint
);
create table t22(
id int,
email varchar(100) primary key,
marks int,
grade char(1),
foreign key (id) references t1(id)
);
create table t33(
email varchar(100),
id int,
branch varchar(10),
city varchar(100),
foreign key (email) references t22(email),
foreign key (id) references t1(id)
); 

