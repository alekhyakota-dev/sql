# LEGB RULE #
# Task 5 – LEGB Rule
# x = 100
# def outer():
#     x = 50
#     def inner():
#         print(x)
#     inner()
# outer()

# what will be printed?
# 50 will be printed.

# x = 100 is a global variable, but it’s not used inside the functions here.
# Inside outer(), x = 50 is a local variable to outer().
# inner() is nested inside outer(). When it does print(x), Python looks for x following the LEGB rule:
# Local → inner() has no x → move to
# Enclosing → outer() has x = 50 → use this → print 50
# Global x = 100 is ignored because enclosing x is closer
# So, the final printed value is 50.

# Why?
# Python follows the LEGB rule for variable lookup:
# Local → Enclosing → Global → Built-in
# inner() doesn’t have its own x, so it uses the x in the enclosing scope (outer()).
# The global x = 100 is ignored because a closer x exists in outer().
