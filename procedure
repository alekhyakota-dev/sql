use coders;

select * from insta_post;

use information_schema;

show tables;

select * from ROUTINES;

use coders;

delimiter $$
create procedure prompt(in a int)
begin
select * from insta_post where likes>a;
end $$
delimiter ;

call prompt(300);

delimiter $$
create procedure li(a int)
begin
select * from insta_post where likes>500;
end $$
delimiter ;

call li(500);
call li(@b);

delimiter $$
create procedure hybrid(in a int, out b int)
begin
select * from insta_post where likes>a;
end $$
delimiter ;

call hybrid(300,@b);

delimiter $$
create procedure _common(inout a int)
begin
select * from insta_post where likes>a;
end $$
delimiter ;

call _common(500);
